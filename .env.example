# ===========================================
# CONFIGURACIÓN FIRESTORE/FIREBASE
# ===========================================
NEXT_PUBLIC_FIREBASE_API_KEY=tu_api_key_aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu_proyecto_firestore
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=tu_app_id

# ===========================================
# API KEYS DE INTELIGENCIA ARTIFICIAL
# ===========================================
NEXT_PUBLIC_OPENAI_API_KEY=tu_openai_api_key_aqui

# ===========================================
# ENLACES DE AFILIADOS
# ===========================================
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=tu_tag_amazon
NEXT_PUBLIC_AFFILIATE_NETWORKS_JSON=[{"name":"Amazon","api":"https://webservices.amazon.com"}]

# ===========================================
# CONFIGURACIÓN SEO
# ===========================================
NEXT_PUBLIC_SITE_URL=https://tutienda.web.app
NEXT_PUBLIC_SITE_NAME=TiendaLDG

# ===========================================
# GOOGLE ANALYTICS
# ===========================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================================
# TWILTER/TIKTOK ADS
# ===========================================
NEXT_PUBLIC_TWITTER_ADS_ID=tu_twitter_id

# ===========================================
# DESARROLLO/PRODUCCIÓN
# ===========================================
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_DEBUG=true

# ===========================================
# NICHO PRINCIPAL
# ===========================================
NEXT_PUBLIC_NICHE=ropa-y-calzado