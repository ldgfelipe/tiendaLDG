* text=auto
*.ts text
*.tsx text
*.css text
*.md text
*.js text
*.svg text
*.jpg binary
*.png binary

# Next.js
.next/ export
out/ export

# Build artifacts
*.log text
npm-debug.log* text

# Config files
*.json text
*.yml text
*.yaml text

# Shell scripts use LF
*.sh text eol=lf

# Windows scripts use CRLF
*.bat text eol=crlf

# Normal text files
*.txt text