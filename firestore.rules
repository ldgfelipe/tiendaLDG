rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usuarios solo pueden leer sus propios datos
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Productos: públicos solo para lectura, admin para escritura
    match /products/{productId} {
      allow read: if true; // Público
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Blog posts: públicos solo para lectura
    match /blogPosts/{postId} {
      allow read: if true; // Público
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Categorías: públicos
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Analytics: solo lectura para admin, escritura automática
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if true; // Para tracking automático
    }

    // Email subscriptions: solo lectura pública
    match /newsletterSubscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create: if isValidEmail(request.resource.data.email);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Función para verificar admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Validación de email
    function isValidEmail(email) {
      return email is string && 
             email.matches('^[^@]+@[^@]+\\.[^@]+$');
    }
  }
}